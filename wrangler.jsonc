// Cloudflare Workers static assets: `npm run build`, then `npx wrangler deploy`
// uploads dist/. `name` must match the Worker name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koaabooks",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
